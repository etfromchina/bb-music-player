{
  "name": "w-music",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server.js",
    "start": "NODE_ENV=production node server.js",
    "desktop:dev": "electron .",
    "desktop:prepare-icon": "powershell -NoProfile -Command \"Copy-Item -Path '.\\\\dist\\\\icon.png' -Destination '.\\\\icon.png' -Force\"",
    "desktop:build": "npm run desktop:prepare-icon && electron-builder --win dir nsis"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.etfromchina.wmusic",
    "productName": "w-music",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "server.cjs",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      "icon.png"
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "icon.png",
      "target": [
        "dir",
        "nsis"
      ]
    }
  }
}
